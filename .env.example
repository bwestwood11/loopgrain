DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 (private bucket for raw clips and finished edits)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Stripe (use sk_test_ keys until you're ready to take real payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Authorizes Vercel Cron calls to /api/cron/* (any long random string)
CRON_SECRET=

# GA Measurement Protocol API secret (GA Admin > Data streams > Loopgrain > Measurement Protocol API secrets)
GA_API_SECRET=
